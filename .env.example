# Copy this file to `.env.local` (which is git-ignored) and fill in values.
# For local Docker Postgres started by `docker compose up -d`, the default
# below already matches docker-compose.yml — just copy as-is.

DATABASE_URL=postgresql://homepage:homepage_dev@localhost:5433/homepage_sample

# Shared secret for the on-demand revalidation endpoint (app/api/revalidate).
# Generate one with:  openssl rand -hex 32
# Set the same value as the `x-revalidate-secret` header on the Supabase webhook.
REVALIDATE_SECRET=
